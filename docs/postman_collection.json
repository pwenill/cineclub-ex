            "description": "Lister les adherents."
          }
        },
        {
          "name": "POST /adherents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.environment.set('adherentId', String(json.data.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Payet\",\n  \"prenom\": \"Marie\",\n  \"email\": \"marie.payet@example.com\",\n  \"telephone\": \"0692123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/adherents",
            "description": "Creer un adherent. Le test Postman sauvegarde data.id dans adherentId."
          }
        },
        {
          "name": "GET /adherents/:id",
