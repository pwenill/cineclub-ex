# =============================================================================
# Configuration du back-end CinéClub Réunion
# Copier ce fichier en .env puis adapter les valeurs.
# =============================================================================

# ====== Serveur Node ======
NODE_ENV=development
PORT=3000

# ====== MySQL — côté application (compte cineclub_app) ======
MYSQL_HOST=localhost         # "mysql" si l'app tourne DANS docker-compose
MYSQL_PORT=3306
MYSQL_DATABASE=cineclub
MYSQL_USER=cineclub_app
MYSQL_PASSWORD=Cin3club!App2026
MYSQL_CONNECTION_LIMIT=10

# ====== MySQL — init Docker (root utilisé UNIQUEMENT par le conteneur) ======
MYSQL_ROOT_PASSWORD=R00t!Cin3club2026

# ====== MongoDB — côté application ======
# Local : mongodb://user:pass@localhost:27017/cineclub?authSource=cineclub
# Atlas : mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cineclub
MONGO_URI=mongodb://cineclub_app:Cin3club!App2026@localhost:27017/cineclub?authSource=cineclub
MONGO_DB_NAME=cineclub

# ====== MongoDB — init Docker ======
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=R00t!Cin3club2026
MONGO_APP_USER=cineclub_app
MONGO_APP_PASSWORD=Cin3club!App2026

# ====== Mongo Express (IHM web) ======
ME_USER=admin
ME_PASSWORD=admin

# ====== Redis — cache applicatif ======
# Host : localhost si l'app tourne sur la machine, redis si elle tourne dans compose.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
