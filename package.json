{
  "name": "cineclub-backend",
  "version": "1.0.0",
  "description": "Back-end Node.js/TypeScript pour CinéClub Réunion - DAL SQL + NoSQL",
  "keywords": [
    "cineclub",
    "dal",
    "mysql",
    "mongodb",
    "typescript"
  ],
  "license": "ISC",
  "author": "Greg - CDA",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html",
    "test:watch": "jest --watch",
    "test:db": "ts-node src/index.ts"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.0",
    "mysql2": "^3.9.7",
    "slugify": "^1.6.9",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
